RABBITMQ_URL=
RABBITMQ_SCHEME=amqps
RABBITMQ_HOST=prod-rabbitmq.internal
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_TLS_ENABLED=true
EXCHANGE_NAME=poc.events
DLX_NAME=poc.dlx
QUEUE_NAME=poc.queue
RETRY_QUEUE_NAME=poc.queue.retry
DLQ_NAME=poc.queue.dlq
ROUTING_KEY=poc.message
RETRY_DELAY_MS=5000
MAX_RETRIES=5
PRODUCER_PORT=8080
CONSUMER_METRICS_PORT=9100

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=poc.consumed
