{
  "family": "poc-producer-consumer",
  "containerDefinitions": [
    {
      "name": "producer-go",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/poc-producer:latest",
      "essential": true,
      "secrets": [
        { "name": "RABBITMQ_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:poc/rabbitmq/url" },
        { "name": "RABBITMQ_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:poc/rabbitmq/username" },
        { "name": "RABBITMQ_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:poc/rabbitmq/password" }
      ],
      "environment": [
        { "name": "RABBITMQ_HOST", "value": "b-1.poc-rmq.internal" },
        { "name": "RABBITMQ_PORT", "value": "5671" },
        { "name": "RABBITMQ_TLS_ENABLED", "value": "true" },
        { "name": "EXCHANGE_NAME", "value": "poc.events" },
        { "name": "QUEUE_NAME", "value": "poc.queue" }
      ]
    }
  ]
}
